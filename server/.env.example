PORT=8787
PUBLIC_BASE_URL=http://127.0.0.1:8787
ALLOWED_ORIGINS=http://127.0.0.1:4173

# Start with true to test the entire flow without spending on AI.
MOCK_MODE=true

# OpenAI-compatible image edit endpoint. Keep the key on the server.
AI_BASE_URL=https://api.xn--lbr707ayot.com
AI_GENERATE_PATH=/v1/images/edits
AI_API_KEY=
AI_MODEL=[企业级]gpt-image-2
AI_IMAGE_FIELD=image
AI_SIZE=
AI_TIMEOUT_MS=120000

# Generation abuse protection. Duplicate request IDs are always idempotent.
GENERATION_SESSION_COOLDOWN_SECONDS=30
GENERATION_IP_WINDOW_SECONDS=600
GENERATION_IP_MAX_REQUESTS=30

# Merchant routes are protected by this server-only password.
MERCHANT_PASSWORD=change-this-before-deploying
SESSION_SECRET=replace-with-a-long-random-secret
SESSION_TTL_SECONDS=28800

# Optional. The frontend already has a static fallback QR image.
PAYMENT_QR_URL=
